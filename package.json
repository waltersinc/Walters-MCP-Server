{
  "name": "walters-mcp-server",
  "version": "1.0.0",
  "description": "MCP server exposing the Walters DataWarehouse-API (labour, workorder, project and purchasing questions) to Microsoft Copilot",
  "type": "module",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waltersinc/Walters-MCP-Server.git"
  },
  "bugs": {
    "url": "https://github.com/waltersinc/Walters-MCP-Server/issues"
  },
  "homepage": "https://github.com/waltersinc/Walters-MCP-Server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.7",
    "typescript": "^5.9.3"
  }
}
