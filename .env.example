# Copy to .env (not committed) and fill in real values.

# Host port that maps to the container's 8080. Pick one that is free on this server -
# the DataWarehouse-API container usually already holds 8080.
HOST_PORT=8081

# Time zone used by the get_current_date tool for "today" / "last week" boundaries.
TIME_ZONE=America/Toronto

# --- The DataWarehouse-API this server calls -------------------------------------------
# Where the DataWarehouse-API container is reachable FROM INSIDE this container.
#   - published on this same Docker host:  http://host.docker.internal:<its HOST_PORT>
#   - another machine:                      http://<hostname-or-ip>:<port>
#   - shared Docker network:                http://<service-name>:8080
DW_API_BASE_URL=http://host.docker.internal:8080
# The DataWarehouse-API's BASIC_AUTH_USERNAME / BASIC_AUTH_PASSWORD values.
DW_API_USERNAME=
DW_API_PASSWORD=
DW_API_TIMEOUT_MS=60000

# --- Credentials Microsoft Copilot (the custom connector) must present to THIS server ----
# Any values you choose - not real accounts, just a shared secret. Use a strong password.
MCP_BASIC_AUTH_USERNAME=
MCP_BASIC_AUTH_PASSWORD=

# Optional: comma-separated Host headers to accept (DNS-rebinding protection), e.g.
# mcp.walters.local,wincdocker. Leave empty to accept any Host (Basic auth still applies).
ALLOWED_HOSTS=
